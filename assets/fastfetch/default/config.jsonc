{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    "uptime",
    {
      "type": "command",
      "key": "OS Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },

    "break",

    "os",
    "kernel",
    "shell",
    "de",
    "wm",
    "packages",

    "break",
    
    "host",
    "battery",
    "localip",
    
    "break",
    
    "display",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "swap",
    
    "break",

    "wmtheme",
    "theme",
    "icons",
    "font",

    "break",
    "colors"
  ]
}
